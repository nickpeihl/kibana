{
  "resource": {
    "elasticstack_kibana_dashboard": {
      "oas_create_simple": {
        "panels": [
          {
            "type": "markdown",
            "grid": {
              "h": 15,
              "w": 24,
              "x": 0,
              "y": 0
            },
            "markdown_config": {
              "content": "## Web logs overview\n\n&nbsp;\n\nCreated with the [Dashboards API](https://www.elastic.co/docs/api/doc/kibana) using the Kibana sample web logs dataset (`kibana_sample_data_logs`). Contains:\n- This markdown panel\n- 2 metrics, showing request count and average response size\n- A line chart based on an ES|QL query\n\n&nbsp;\n\n&nbsp;\n\n[Learn more about dashboards](https://www.elastic.co/docs/explore-analyze/dashboards)"
            }
          },
          {
            "type": "vis",
            "grid": {
              "h": 5,
              "w": 12,
              "x": 24,
              "y": 0
            },
            "vis_config": {
              "by_value": {
                "metric_chart_config": {
                  "data_source_json": "{\"type\":\"data_view_spec\",\"index_pattern\":\"kibana_sample_data_logs\",\"time_field\":\"timestamp\"}",
                  "metrics": [
                    {
                      "config_json": "{\"type\":\"primary\",\"operation\":\"count\"}"
                    }
                  ]
                }
              }
            }
          },
          {
            "type": "vis",
            "grid": {
              "h": 5,
              "w": 12,
              "x": 36,
              "y": 0
            },
            "vis_config": {
              "by_value": {
                "metric_chart_config": {
                  "data_source_json": "{\"type\":\"data_view_spec\",\"index_pattern\":\"kibana_sample_data_logs\",\"time_field\":\"timestamp\"}",
                  "metrics": [
                    {
                      "config_json": "{\"type\":\"primary\",\"operation\":\"average\",\"field\":\"bytes\"}"
                    }
                  ]
                }
              }
            }
          },
          {
            "type": "vis",
            "grid": {
              "h": 10,
              "w": 24,
              "x": 24,
              "y": 5
            },
            "vis_config": {
              "by_value": {
                "xy_chart_config": {
                  "axis": {
                    "x": {
                      "title": {
                        "visible": false
                      }
                    }
                  },
                  "layers": [
                    {
                      "type": "line",
                      "data_layer": {
                        "data_source_json": "{\"type\":\"esql\",\"query\":\"FROM kibana_sample_data_logs | STATS count = COUNT() BY BUCKET(@timestamp, 75, ?_tstart, ?_tend)\"}",
                        "x_json": "{\"column\":\"BUCKET(@timestamp, 75, ?_tstart, ?_tend)\"}",
                        "y": [
                          {
                            "config_json": "{\"column\":\"count\"}"
                          }
                        ]
                      }
                    }
                  ],
                  "title": "Requests over time"
                }
              }
            }
          }
        ],
        "title": "Web logs overview"
      }
    }
  }
}
