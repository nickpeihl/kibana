{
  "resource": {
    "elasticstack_kibana_dashboard": {
      "image_file_src": {
        "description": "Image panel with file src (placeholder file_id — may be rejected by Kibana if it validates uploads)",
        "panels": [
          {
            "type": "image",
            "grid": {
              "h": 8,
              "w": 24,
              "x": 0,
              "y": 0
            },
            "image_config": {
              "alt_text": "placeholder file reference",
              "src": {
                "file": {
                  "file_id": "acc-test-placeholder-file-id"
                }
              }
            }
          }
        ],
        "query": {
          "expression": "",
          "language": "kql"
        },
        "refresh_interval": {
          "pause": true,
          "value": 0
        },
        "time_range": {
          "from": "now-15m",
          "to": "now"
        },
        "title": "Image file src"
      }
    }
  }
}
