{
  "resource": {
    "elasticstack_kibana_dashboard": {
      "image_url_src_drilldowns": {
        "description": "Dashboard with typed image panel (URL src, mixed drilldowns)",
        "panels": [
          {
            "type": "image",
            "grid": {
              "h": 10,
              "w": 24,
              "x": 0,
              "y": 0
            },
            "image_config": {
              "description": "Image panel description",
              "drilldowns": [
                {
                  "dashboard_drilldown": {
                    "dashboard_id": "spike0-target-dashboard",
                    "label": "Open dashboard",
                    "trigger": "on_click_image"
                  }
                },
                {
                  "url_drilldown": {
                    "label": "External link",
                    "trigger": "on_click_image",
                    "url": "https://example.com/details/{{context.panel.title}}"
                  }
                }
              ],
              "hide_border": true,
              "hide_title": false,
              "alt_text": "Logo",
              "background_color": "#111111",
              "object_fit": "cover",
              "src": {
                "url": {
                  "url": "https://example.com/logo.png"
                }
              },
              "title": "Image panel title"
            }
          }
        ],
        "query": {
          "expression": "",
          "language": "kql"
        },
        "refresh_interval": {
          "pause": true,
          "value": 0
        },
        "time_range": {
          "from": "now-15m",
          "to": "now"
        },
        "title": "Image url src"
      }
    }
  }
}
